    {
        "id": "5956fe352cdd72f5",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "// Converte os dados do Wokwi (JSON)\nvar dados = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n\n// Puxa o histórico ou cria lista vazia\nvar historico = flow.get(\"historico_sensores\") || [];\n\n// Cria a nova linha\nvar novaLinha = {\n    hora: new Date().toLocaleTimeString('pt-BR'),\n    movimento: dados.movement == 1 ? \"🚨 Detectado\" : \"Manual\",\n    botao: dados.button == 1 ? \"🔴 Alarme Desativado\" : \"🟢 Ativo\"\n};\n\n// Adiciona no topo da lista\nhistorico.unshift(novaLinha);\n\n// Limita a 10 registos\nif (historico.length > 10) {\n    historico.pop();\n}\n\n// Guarda na memória do Node-RED\nflow.set(\"historico_sensores\", historico);\n\n// 1º Passo: Dispara uma lista vazia para forçar a limpeza da tabela no ecrã\nnode.send({ payload: [] });\n\n// 2º Passo: Dispara a lista ordenada atualizada\nnode.send({ payload: historico });\n\n// Encerra a função\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 380,
        "wires": [
            [
                "ca7ee6729810ee83"
            ]
        ]
    },
