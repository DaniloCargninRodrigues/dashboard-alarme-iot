    {
        "id": "c73d9eb8ddf91795",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 3",
        "func": "// Garante que o payload do MQTT é convertido de string para objeto JSON\nvar dados = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n\n// Verifica se o movimento é exatamente 1 (invasão)\nif (dados.movement === 1) {\n    // Deixa a mensagem seguir para o próximo nó\n    return msg;\n}\n\n// Se for 0 ou qualquer outra coisa, bloqueia a mensagem\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
